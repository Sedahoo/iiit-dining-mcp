# Copy to .env and fill in. .env is gitignored.

# Auth key from dining.iiit.ac.in -> Settings -> Auth Keys.
# Public tools (menus, timings) work without it.
DINING_AUTH_KEY=paste-your-auth-key-here

# Optional overrides (defaults shown)
# DINING_AUTH_SCHEME=raw
# DINING_BASE_URL=https://dining.iiit.ac.in
